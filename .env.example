# 포트 — 같은 서버의 다른 프로그램과 겹치지 않게 둔다(캠카 3000 · MRJBJ 3100 · koreabts 3200/3201).
PORT=3300

# 서버 안(127.0.0.1)에서만 받는다. 손님은 nginx(80 · 443)를 거쳐 들어온다.
# 밖에서 직접 받아야 할 때만 0.0.0.0 으로 연다.
LISTEN_HOST=127.0.0.1

# 사이트 주소 — sitemap.xml · 공유 링크의 기준. 도메인이 정해지면 바꾼다.
SITE_URL=https://upbattery.example.com

# SQLite 파일 위치(이 폴더 기준).
DB_PATH=./data/upgrade.db

# 문의 · 예약 목록(/admin)을 여는 비밀번호. 비워두면 /admin 이 아예 열리지 않는다(404).
# 아이디는 ADMIN_USER(기본 admin). 값을 대화창이나 저장소에 붙이지 말고 서버에서만 넣는다.
ADMIN_USER=admin
ADMIN_PASSWORD=
